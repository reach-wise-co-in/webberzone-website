# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (used for canonical links and structured data)
NEXT_PUBLIC_SITE_URL=https://web.reachwise.co.in

# WhatsApp lead delivery via CallMeBot (free).
# Get the key: from +91 85590 68976, send "I allow callmebot to send me messages"
# on WhatsApp to the number listed at https://www.callmebot.com/blog/free-api-whatsapp-messages/
# CallMeBot replies with your API key.
CALLMEBOT_API_KEY=

# Optional: send leads to a different WhatsApp number (international format)
LEAD_WHATSAPP_NUMBER=+918559068976
